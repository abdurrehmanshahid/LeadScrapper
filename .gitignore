# Fresh/offline machines still seed from the tracked enriched_odoo_leads.json.
data/leads_db.json
data/leads_db.backup.json
data/call_logs.json

# User accounts / password hashes — must never leave the machine
data/users.json

# graphify code-graph output — generated locally (rebuild: graphify update .)
graphify-out/

# Local Claude Code hooks (machine-specific graphify paths)
.claude/settings.json
