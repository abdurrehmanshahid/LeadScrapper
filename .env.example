# ─── Big Binary Tech — Lead Intelligence Engine ───────────────────────────────
#
# Copy this file to .env and fill in your values.
# The app works without any of these — it falls back to local JSON storage.
#
# ─── MongoDB Atlas (Cloud Sync across multiple PCs) ───────────────────────────
#
# 1. Go to https://www.mongodb.com/cloud/atlas/register
# 2. Create a FREE M0 cluster (no credit card needed)
# 3. Click "Connect" → "Drivers" → copy the connection string
# 4. Replace <username>, <password>, and <dbname> below
#
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bigbinary_leads?retryWrites=true&w=majority
#
# Once set, every PC with this same .env will share live lead data automatically.
# ─────────────────────────────────────────────────────────────────────────────

# Optional: change the port the server runs on (default: 3000)
# PORT=3000
